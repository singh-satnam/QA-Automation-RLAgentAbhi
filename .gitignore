# ---------------------------------------------------------------------------
# Python / pytest
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Run-time state that should NEVER be committed
# ---------------------------------------------------------------------------
# Agent stop signal (sentinel file polled by stream_command)
core/reports/.stop_signal
# Playwright auth state cache
core/reports/.storage_state.json
# Browser-process logs
agent_ui.log
generation_log.txt

# ---------------------------------------------------------------------------
# Per-run snapshots — accumulate without bound, not useful in git
# ---------------------------------------------------------------------------
workspace/projects/*/*/reports/runs/
workspace/*/report/
workspace/**/report/

# ---------------------------------------------------------------------------
# Local-only stash for the demo replay (not for shared use)
# ---------------------------------------------------------------------------
workspace/projects/*/*/.demo_stash/

# ---------------------------------------------------------------------------
# Staging workspace — generated files before promotion to workspace/
# ---------------------------------------------------------------------------
temp_workspace/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Optional sidecar test data the user uploaded — keep out of git so secrets
# in CSV/JSON test files aren't accidentally published.
# ---------------------------------------------------------------------------
user_data.json
user_data.csv
user_data.tsv
user_data.xlsx
user_data.xls

# MCP browser session logs + DOM snapshots (cache, not source)
.playwright-mcp/
.claude/
